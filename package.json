{
  "name": "github-action-standalone-stats",
  "version": "1.0.0",
  "description": "Self-hosted test and coverage stats for GitHub Actions: merges results across a matrix, keeps history on a branch, and publishes a dashboard and badges with GitHub Pages. No third-party service.",
  "private": true,
  "type": "module",
  "author": "Cameron Tacklind <cameron@tacklind.com>",
  "license": "MIT",
  "keywords": [
    "github-actions",
    "test-results",
    "coverage",
    "junit",
    "ctrf",
    "allure",
    "stats",
    "gh-pages"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "tsc --noEmit && tsc --noEmit -p viewer && tsc --noEmit -p e2e",
    "test": "bun test --timeout 30000",
    "e2e": "bun scripts/demo-data.ts && playwright test",
    "viewer:demo": "bun scripts/demo-data.ts",
    "viewer:dev": "vite --config viewer/vite.config.ts",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/github-action-standalone-stats.git"
  },
  "dependencies": {
    "@actions/artifact": "6.3.1",
    "@actions/core": "^3.0.1",
    "@actions/glob": "0.7.0",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "^3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  }
}
